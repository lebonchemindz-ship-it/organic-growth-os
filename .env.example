# ============================================================
# Organic Growth OS — environment variables
# Copy to .env for local development, or set in Vercel →
# Project → Settings → Environment Variables for production.
# Nothing here is secret until you fill it in.
# ============================================================

# ---- Layer 1: the brain (pick ONE for the Sprout agent) ----
# Recommended: Anthropic Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-4-5)
ANTHROPIC_MODEL=
# Alternative: OpenAI (platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Database ----
# SQLite for local dev. In production Vercel this is set automatically.
DATABASE_URL="file:./db/custom.db"

# ---- Layer 2: shared infrastructure (connect once) ----
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
ACTIVEPIECES_API_KEY=
ACTIVEPIECES_WEBHOOK_URL=
HUNTER_API_KEY=
RECRAFT_API_KEY=

# Optional: OpenSEO (github.com/every-app/open-seo) as the all-in-one
# SEO data brain via MCP — alternative to wiring DataForSEO yourself
OPENSEO_API_KEY=
OPENSEO_MCP_URL=

# ---- Per-brand (repeat per brand) ----
GSC_SITE_URL=
GA4_PROPERTY_ID=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
MERCHANT_ID=
BING_API_KEY=
INDEXNOW_KEY=
